{
  "name": "google-ads-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Google Ads integration with Claude AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-ads-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "setup:auth": "tsx scripts/setup-oauth.ts",
    "setup:claude": "./scripts/configure-claude-desktop.sh",
    "setup:all": "npm run setup:auth && npm run build && npm run setup:claude"
  },
  "keywords": [
    "mcp",
    "google-ads",
    "claude",
    "ai",
    "advertising",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "google-ads-api": "^17.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "open": "^10.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
