# ===============================================
# AI News Scraper Configuration
# Copy this to .env and fill in your actual values
# ===============================================

# REQUIRED: Metricool API Configuration
# Get these from: Metricool Account Settings > API
METRICOOL_TOKEN=your_metricool_api_token_here
METRICOOL_USER_ID=12345678
METRICOOL_BLOG_ID=87654321

# REQUIRED: NewsAPI Configuration
# Free tier: 100 requests/day
# Get your key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# OPTIONAL: Reddit API Configuration
# Get credentials at: https://reddit.com/prefs/apps
# Free tier is sufficient for this project
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AI News Scraper v1.0

# OPTIONAL: Twitter API v2 Configuration
# Requires paid tier ($100+/month for Starter)
# Get credentials at: https://developer.twitter.com
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Database Configuration
DATABASE_PATH=ai_news.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=ai_news_scraper.log

# Timezone Configuration
POSTING_TIMEZONE=America/New_York
